# BNB Smart Chain RPC endpoint
BSC_RPC_URL=https://bsc-dataseed.binance.org/

# BNB Smart Chain Network ID (56 for Mainnet)
CHAIN_ID=56

# Private key of trading wallet (0x...)
PRIVATE_KEY=your_private_key_here

# Router Contract Address (Axiom BNB V2 or PancakeSwap Router V2)
ROUTER_ADDRESS=0x10ED433D51B191656629E9baeC6544610146585c

# Wrapped BNB (WBNB) Address
WBNB_ADDRESS=0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c

# Target Token Contract Address to trade
TARGET_TOKEN_ADDRESS=0xe9e7CEA3DedcA5984780Bafc599bD69ADd087D56

# Trading Slippage Percentage (e.g., 1.0 for 1%)
SLIPPAGE_PERCENT=1.0

# Gas settings (Gwei, set 0 for automatic dynamic market estimation)
GAS_PRICE_GWEI=3.0
GAS_LIMIT=300000

# Automation Settings
MIN_BUY_AMOUNT_BNB=0.01
MAX_BUY_AMOUNT_BNB=0.05
CHECK_INTERVAL_SECONDS=10

# Risk Management Logic (%)
STOP_LOSS_PERCENT=10.0
TAKE_PROFIT_PERCENT=20.0
